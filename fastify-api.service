[Unit]
Description=Fastify API with PM2
After=network.target postgresql.service docker.service

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/fastify-api
Environment=PATH=/usr/bin:/usr/local/bin
Environment=PM2_HOME=/home/pi/.pm2
ExecStart=/usr/local/bin/pm2 start ecosystem.config.js --env production
ExecStop=/usr/local/bin/pm2 stop all
ExecReload=/usr/local/bin/pm2 restart all
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastify-api

[Install]
WantedBy=multi-user.target
