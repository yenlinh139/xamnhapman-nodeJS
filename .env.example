# Port run app
NODE_ENV="production"
BASE_URL_LOCAL="http://localhost"
FRONTEND_URL="http://localhost"
PORT="4000"

# Token
ACCESS_TOKEN="your_access_token_here"
REFRESH_TOKEN="your_refresh_token_here"
EXPIRES_ACCESS_TOKEN="1h"
EXPIRES_REFRESH_TOKEN="3d"

# Bcrypt
SECRET_KEY_SALT="your_secret_key_salt_here"
JWT_SECRET="your_jwt_secret_here"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# PostgreSQL Database
DB_HOST="localhost"
DB_DATABASE="xamnhapman_tphcm"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your_database_password"

# Email Configuration (NodeMailer)
# Supported providers: gmail | mailtrap | brevo | sendgrid
MAIL_PROVIDER="gmail"
MAIL_HOST=""
MAIL_PORT=""
MAIL_SECURE=""
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="no-reply@example.com"

# Backward-compatible fallback vars
EMAIL="your_email@example.com"
EMAIL_PASSWORD="your_app_password"

# GeoServer (WFS nội bộ cho nhãn huyện/xã trên bản đồ - mapLabels.controller.js).
# Khi chạy "docker-compose up" cả cụm, để mặc định (http://geoserver:8080/geoserver) là đủ vì
# backend gọi geoserver qua tên service trong cùng mạng Docker.
# Khi chạy backend bằng "npm run dev" NGOÀI Docker (chỉ geoserver chạy qua docker-compose), phải
# trỏ qua cổng đã publish ra host - xem GEOSERVER_PORT ở file .env gốc của repo, ví dụ:
# GEOSERVER_INTERNAL_URL="http://localhost:8080/geoserver"
GEOSERVER_INTERNAL_URL="http://geoserver:8080/geoserver"
GS_WORKSPACE="xamnhapman_tphcm"

# Forecast API (dữ liệu dự báo độ mặn, môi trường staging)
FORECAST_API_BASE_URL="https://136.85.17.205"
ENABLE_FORECAST_SYNC_CRON="true"

# "Bay gio" dung de chon moc du bao "hien tai" (vd popup ban do). Rong hoac "now" = dung
# thoi gian thuc (van hanh that). Dat 1 ngay (vd "20240801") de test khi du lieu du bao
# con la mau co dinh trong qua khu, giup moc "hien tai" nam trong chuoi du bao thay vi
# luon roi vao diem cuoi cung.
FORECAST_NOW_OVERRIDE=""
ENABLE_FORECAST_SYNC_CRON="true"
